# No TLS anywhere: remote access is plain telnet only
# CONFIG_SSL_SERVER is not set
# CONFIG_SSL_CLIENT is not set
# CONFIG_FEATURE_WGET_HTTPS is not set
# CONFIG_FEATURE_WGET_OPENSSL is not set

# Remote access and services (telnet root shell + FTP, no other daemons)
CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_TCPSVD=y
CONFIG_FTPD=y
CONFIG_FEATURE_FTPD_WRITE=y
CONFIG_TIMEOUT=y
CONFIG_BLOCKDEV=y
CONFIG_STAT=y
# Not used: nothing writable for them on the read-only root
# CONFIG_HTTPD is not set
# CONFIG_UDHCPD is not set
# CONFIG_NTPD is not set
# CONFIG_SYSLOGD is not set
# CONFIG_KLOGD is not set
# CONFIG_CROND is not set
# CONFIG_CRONTAB is not set
# CONFIG_SEEDRNG is not set
