From: magpie <noreply@example.invalid>
Subject: [PATCH] ARM: at91: pm: stock-style backup sleep for sam9x5

Add an optional "mem" sleep for the SAM9x5 family that works the way the
stock firmware did: put the SDRAM in self-refresh, cut VDDCORE through the
shutdown controller and, on wake, let the at91bootstrap in SPI flash jump
to a resume entry (GPBR0 magic, GPBR1 = entry, 0x2bedf00d before it) that
continues in cpu_resume.

The core power cut also wipes PMC, AIC and PIO, so their registers are
saved right before cpu_suspend() and restored right after it returns (PMC
first, then AIC, then PIO), before the PM core resumes anything else.
GPBR1 (also the boot progress marker) is saved and restored around the
sleep, GPBR2 (bootstrap boot counter) and GPBR0 are cleared afterwards,
and GPBR3 carries progress markers. Enabled by
CONFIG_AT91_SAM9_BACKUP_SLEEP.

Signed-off-by: magpie <noreply@example.invalid>
---
diff --git a/arch/arm/mach-at91/Kconfig b/arch/arm/mach-at91/Kconfig
index c5ef27e..6f74e07 100644
--- a/arch/arm/mach-at91/Kconfig
+++ b/arch/arm/mach-at91/Kconfig
@@ -249,6 +249,17 @@ config SOC_SAMA5
 config ATMEL_PM
 	bool
 
+config AT91_SAM9_BACKUP_SLEEP
+	bool "Stock-style backup sleep for SAM9x5 (SDRAM self-refresh, VDDCORE off)"
+	depends on ATMEL_PM && SOC_AT91SAM9
+	help
+	  Make "mem" suspend put the SDRAM in self-refresh and cut the core
+	  power through the shutdown controller. Needs an at91bootstrap that
+	  jumps to the address in GPBR1 when GPBR0 holds 0xCAFEBABE and the
+	  word before it is 0x2BEDF00D. The PMC, AIC and PIO registers are
+	  saved before the sleep and restored after it. Say n unless your
+	  board has such a bootstrap.
+
 config ATMEL_SECURE_PM
 	bool "Atmel Secure PM support"
 	depends on SOC_SAMA5D2 && ATMEL_PM
diff --git a/arch/arm/mach-at91/Makefile b/arch/arm/mach-at91/Makefile
index 7d8a7bc..d1cce91 100644
--- a/arch/arm/mach-at91/Makefile
+++ b/arch/arm/mach-at91/Makefile
@@ -14,6 +14,7 @@ obj-$(CONFIG_SOC_SAMV7)		+= samv7.o
 
 # Power Management
 obj-$(CONFIG_ATMEL_PM)		+= pm.o pm_suspend.o
+obj-$(CONFIG_AT91_SAM9_BACKUP_SLEEP) += pm_sam9_backup.o pm_sam9_backup_asm.o
 
 ifeq ($(CONFIG_PM_DEBUG),y)
 CFLAGS_pm.o += -DDEBUG
diff --git a/arch/arm/mach-at91/generic.h b/arch/arm/mach-at91/generic.h
index acf0b3c..45ff521 100644
--- a/arch/arm/mach-at91/generic.h
+++ b/arch/arm/mach-at91/generic.h
@@ -8,6 +8,9 @@
 #ifndef _AT91_GENERIC_H
 #define _AT91_GENERIC_H
 
+#include <linux/errno.h>
+#include <linux/types.h>
+
 #ifdef CONFIG_PM
 extern void __init at91rm9200_pm_init(void);
 extern void __init at91sam9_pm_init(void);
@@ -26,4 +29,14 @@ static inline void __init sama5d2_pm_init(void) { }
 static inline void __init sama7_pm_init(void) { }
 #endif
 
+#ifdef CONFIG_AT91_SAM9_BACKUP_SLEEP
+extern void __init at91_sam9_backup_init(void);
+extern bool at91_sam9_backup_ready(void);
+extern int at91_sam9_backup_suspend(void);
+#else
+static inline void __init at91_sam9_backup_init(void) { }
+static inline bool at91_sam9_backup_ready(void) { return false; }
+static inline int at91_sam9_backup_suspend(void) { return -ENODEV; }
+#endif
+
 #endif /* _AT91_GENERIC_H */
diff --git a/arch/arm/mach-at91/pm.c b/arch/arm/mach-at91/pm.c
index 35058b9..c8d0648 100644
--- a/arch/arm/mach-at91/pm.c
+++ b/arch/arm/mach-at91/pm.c
@@ -688,6 +688,11 @@ static int at91_pm_enter(suspend_state_t state)
 		    !at91_pm_verify_clocks())
 			goto error;
 
+		if (state == PM_SUSPEND_MEM && at91_sam9_backup_ready()) {
+			at91_sam9_backup_suspend();
+			break;
+		}
+
 		at91_pm_suspend(state);
 
 		break;
@@ -1576,6 +1581,7 @@ void __init at91sam9_pm_init(void)
 		return;
 
 	at91_pm_init(at91sam9_idle);
+	at91_sam9_backup_init();
 }
 
 void __init sama5_pm_init(void)
diff --git a/arch/arm/mach-at91/pm_sam9_backup.c b/arch/arm/mach-at91/pm_sam9_backup.c
new file mode 100644
index 0000000..1207a11
--- /dev/null
+++ b/arch/arm/mach-at91/pm_sam9_backup.c
@@ -0,0 +1,458 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Backup sleep for the SAM9x5 family, as the stock firmware did it.
+ *
+ * The state is kept in the SDRAM (self-refresh) while the shutdown controller
+ * cuts VDDCORE. The at91bootstrap in SPI flash re-initializes the SDRAM and,
+ * if GPBR0 holds 0xCAFEBABE, clears it and jumps to the address in GPBR1
+ * (the word before it must be 0x2bedf00d). That address is
+ * at91_sam9_backup_resume, which continues in cpu_resume. The bootstrap also
+ * counts boots in GPBR2 and falls back to SAM-BA above 3, so GPBR2 is cleared
+ * before the power cut and again on resume.
+ *
+ * The core power cut also wipes the PMC, AIC and PIO registers (the bootstrap
+ * only brings the clocks and the SDRAM back, like on a cold boot). They are
+ * saved right before cpu_suspend() and restored right after it returns, with
+ * interrupts still off and before the PM core resumes anything else, which
+ * puts the restore ahead of syscore_resume, timekeeping and the device resume
+ * callbacks. The order is PMC, AIC, PIO: peripheral clocks must run before
+ * the PIO banks (and later the timer) are touched, and the AIC must be back
+ * before anything can raise an interrupt.
+ *
+ * GPBR3 gets progress markers that survive a reset.
+ */
+#include <linux/errno.h>
+#include <linux/genalloc.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/printk.h>
+
+#include <asm/cacheflush.h>
+#include <asm/fncpy.h>
+#include <asm/suspend.h>
+
+#include "generic.h"
+
+#define DDRSDRC_LPR_PHYS	0xffffe81c
+#define SHDW_CR_PHYS		0xfffffe10
+#define SHDW_SR			0x08
+#define BSC_CR_PHYS		0xfffffe54
+#define GPBR_PHYS		0xfffffe60
+#define RTC_SCCR_PHYS		0xfffffecc
+
+#define GPBR0			0x00
+#define GPBR1			0x04
+#define GPBR2			0x08
+#define GPBR3			0x0c
+
+#define BOOT_MAGIC		0xcafebabe
+#define BSC_CR_SPI_BOOT		0x66830004
+#define RTC_SCCR_ALL		0x1f
+
+#define MARK_SUSPENDING		0x4D505700
+#define MARK_BACK_IN_C		0x4D505702
+#define MARK_HW_RESTORED	0x4D505703
+
+#define PMC_PHYS		0xfffffc00
+#define AIC_PHYS		0xfffff000
+#define PIO_PHYS(bank)		(0xfffff400 + (bank) * 0x200)
+#define NR_PIO			4
+
+/* PMC */
+#define PMC_SCER		0x00
+#define PMC_SCDR		0x04
+#define PMC_SCSR		0x08
+#define PMC_PCER		0x10
+#define PMC_PCDR		0x14
+#define PMC_PCSR		0x18
+#define CKGR_UCKR		0x1c
+#define PMC_USB			0x38
+#define PMC_PCK(n)		(0x40 + (n) * 4)
+#define PMC_SR			0x68
+#define PMC_WPMR		0xe4
+#define PMC_SR_LOCKU		BIT(6)
+#define PMC_SR_PCKRDY(n)	BIT(8 + (n))
+#define CKGR_UCKR_UPLLEN	BIT(16)
+/* UDP, UHP, SMDCK, PCK0, PCK1: never DDRCK (SDRAM clock) or PCK (CPU clock) */
+#define PMC_SYSCLK_MASK		(BIT(7) | BIT(6) | BIT(4) | BIT(9) | BIT(8))
+/* Peripheral IDs 0 and 1 (FIQ, SYS) have no clock bit */
+#define PMC_PCLK_MASK		0xfffffffc
+/* PIOA/PIOB are ID 2, PIOC/PIOD are ID 3 */
+#define PMC_PCLK_PIO		(BIT(2) | BIT(3))
+
+/* AIC */
+#define AIC_SMR(n)		(0x00 + (n) * 4)
+#define AIC_SVR(n)		(0x80 + (n) * 4)
+#define AIC_IMR			0x110
+#define AIC_IECR		0x120
+#define AIC_IDCR		0x124
+#define AIC_ICCR		0x128
+#define AIC_EOICR		0x130
+#define AIC_SPU			0x134
+#define AIC_DCR			0x138
+#define AIC_FFER		0x140
+#define AIC_FFSR		0x148
+#define AIC_WPMR		0x1e4
+#define AIC_NR_IRQ		32
+
+/* PIO */
+#define PIO_PER			0x00
+#define PIO_PDR			0x04
+#define PIO_PSR			0x08
+#define PIO_OER			0x10
+#define PIO_ODR			0x14
+#define PIO_OSR			0x18
+#define PIO_IFER		0x20
+#define PIO_IFDR		0x24
+#define PIO_IFSR		0x28
+#define PIO_SODR		0x30
+#define PIO_CODR		0x34
+#define PIO_ODSR		0x38
+#define PIO_IER			0x40
+#define PIO_IDR			0x44
+#define PIO_IMR			0x48
+#define PIO_ISR			0x4c
+#define PIO_MDER		0x50
+#define PIO_MDDR		0x54
+#define PIO_MDSR		0x58
+#define PIO_PUDR		0x60
+#define PIO_PUER		0x64
+#define PIO_PUSR		0x68
+#define PIO_ABCDSR1		0x70
+#define PIO_ABCDSR2		0x74
+#define PIO_IFSCDR		0x80
+#define PIO_IFSCER		0x84
+#define PIO_IFSCSR		0x88
+#define PIO_SCDR		0x8c
+#define PIO_PPDDR		0x90
+#define PIO_PPDER		0x94
+#define PIO_PPDSR		0x98
+#define PIO_OWER		0xa0
+#define PIO_OWDR		0xa4
+#define PIO_OWSR		0xa8
+#define PIO_AIMER		0xb0
+#define PIO_AIMDR		0xb4
+#define PIO_AIMMR		0xb8
+#define PIO_ESR			0xc0
+#define PIO_LSR			0xc4
+#define PIO_ELSR		0xc8
+#define PIO_FELLSR		0xd0
+#define PIO_REHLSR		0xd4
+#define PIO_FRLHSR		0xd8
+#define PIO_WPMR		0xe4
+#define PIO_SCHMITT		0x100
+#define PIO_DELAYR		0x110
+#define PIO_DRIVER1		0x114
+#define PIO_DRIVER2		0x118
+
+extern void at91_sam9_backup_resume(void);
+extern void at91_sam9_backup_sram(void __iomem *lpr, void __iomem *shdw_cr);
+extern char at91_sam9_backup_sram_end[];
+
+static void (*sram_fn)(void __iomem *, void __iomem *);
+static size_t sram_sz;
+static void __iomem *lpr, *shdwc, *bsc_cr, *gpbr, *rtc_sccr;
+static void __iomem *pmc, *aic, *pio[NR_PIO];
+
+/*
+ * One PIO state register and the pair of registers that rebuild it: every
+ * 1 bit of the saved value is written to @set, every 0 bit to @clr. Registers
+ * that are plain read/write have @clr == 0 and @set == @save. Note that the
+ * pull-up and pull-down status registers read 1 for "disabled", so their
+ * @set is the disable register.
+ *
+ * The order is the order of the restore and matters:
+ *  - output data (and its write-enable) before the output enable, so that a
+ *    pin does not drive the reset level when it becomes an output;
+ *  - multi-drive, pull-up/down, filters and drive strength before the pin is
+ *    handed to its function;
+ *  - the A/B/C/D function select while the pin is still under PIO control;
+ *  - output enable, then the interrupt modes, then the interrupt mask, with
+ *    the status read in between to drop what the mode changes latched;
+ *  - PER/PDR last, which is what actually connects a pin to its peripheral.
+ */
+struct pio_item {
+	u16 save, set, clr;
+};
+
+static const struct pio_item pio_items[] = {
+	{ PIO_OWSR,    PIO_OWER,    PIO_OWDR },
+	{ PIO_ODSR,    PIO_SODR,    PIO_CODR },
+	{ PIO_MDSR,    PIO_MDER,    PIO_MDDR },
+	{ PIO_PUSR,    PIO_PUDR,    PIO_PUER },
+	{ PIO_PPDSR,   PIO_PPDDR,   PIO_PPDER },
+	{ PIO_IFSR,    PIO_IFER,    PIO_IFDR },
+	{ PIO_IFSCSR,  PIO_IFSCER,  PIO_IFSCDR },
+	{ PIO_SCDR,    PIO_SCDR },
+	{ PIO_SCHMITT, PIO_SCHMITT },
+	{ PIO_DELAYR,  PIO_DELAYR },
+	{ PIO_DRIVER1, PIO_DRIVER1 },
+	{ PIO_DRIVER2, PIO_DRIVER2 },
+	{ PIO_ABCDSR1, PIO_ABCDSR1 },
+	{ PIO_ABCDSR2, PIO_ABCDSR2 },
+	{ PIO_OSR,     PIO_OER,     PIO_ODR },
+	{ PIO_AIMMR,   PIO_AIMER,   PIO_AIMDR },
+	{ PIO_ELSR,    PIO_LSR,     PIO_ESR },	/* 1 = level */
+	{ PIO_FRLHSR,  PIO_REHLSR,  PIO_FELLSR },	/* 1 = rising/high */
+	{ PIO_IMR,     PIO_IER,     PIO_IDR },
+	{ PIO_PSR,     PIO_PER,     PIO_PDR },	/* 1 = PIO controls the pin */
+};
+#define PIO_ISR_BEFORE		(ARRAY_SIZE(pio_items) - 2)	/* the IMR entry */
+
+static struct {
+	u32 scsr, pcsr, uckr, usb, pck[2];
+} pmc_ctx;
+
+static struct {
+	u32 smr[AIC_NR_IRQ], svr[AIC_NR_IRQ];
+	u32 imr, spu, dcr, ffsr;
+} aic_ctx;
+
+static u32 pio_ctx[NR_PIO][ARRAY_SIZE(pio_items)];
+
+static void hw_save(void)
+{
+	int i, b;
+
+	if ((readl(pmc + PMC_WPMR) | readl(aic + AIC_WPMR) |
+	     readl(pio[0] + PIO_WPMR)) & 1)
+		pr_warn("at91-backup: write protection is on, restore may be incomplete\n");
+
+	pmc_ctx.scsr = readl(pmc + PMC_SCSR);
+	pmc_ctx.pcsr = readl(pmc + PMC_PCSR);
+	pmc_ctx.uckr = readl(pmc + CKGR_UCKR);
+	pmc_ctx.usb = readl(pmc + PMC_USB);
+	pmc_ctx.pck[0] = readl(pmc + PMC_PCK(0));
+	pmc_ctx.pck[1] = readl(pmc + PMC_PCK(1));
+
+	for (i = 0; i < AIC_NR_IRQ; i++) {
+		aic_ctx.smr[i] = readl(aic + AIC_SMR(i));
+		aic_ctx.svr[i] = readl(aic + AIC_SVR(i));
+	}
+	aic_ctx.imr = readl(aic + AIC_IMR);
+	aic_ctx.spu = readl(aic + AIC_SPU);
+	aic_ctx.dcr = readl(aic + AIC_DCR);
+	aic_ctx.ffsr = readl(aic + AIC_FFSR);
+
+	/* The PIO banks may be clock gated (pinctrl does it when idle) */
+	writel(PMC_PCLK_PIO, pmc + PMC_PCER);
+	for (b = 0; b < NR_PIO; b++)
+		for (i = 0; i < ARRAY_SIZE(pio_items); i++)
+			pio_ctx[b][i] = readl(pio[b] + pio_items[i].save);
+	writel(~pmc_ctx.pcsr & PMC_PCLK_PIO, pmc + PMC_PCDR);
+}
+
+static void pmc_wait(u32 mask, const char *what)
+{
+	u32 sr;
+
+	if (readl_poll_timeout_atomic(pmc + PMC_SR, sr, (sr & mask) == mask,
+				      1, 20000))
+		pr_warn("at91-backup: %s not ready (PMC_SR=0x%08x)\n", what, sr);
+}
+
+static void pmc_restore(void)
+{
+	u32 sc = pmc_ctx.scsr & PMC_SYSCLK_MASK;
+	u32 pc = pmc_ctx.pcsr & PMC_PCLK_MASK;
+	int i;
+
+	/*
+	 * PLLA and the master clock are already as before (the bootstrap sets
+	 * them up like on a cold boot). The UTMI PLL goes first because the USB
+	 * clock and the USB system clocks depend on it.
+	 */
+	writel(pmc_ctx.uckr, pmc + CKGR_UCKR);
+	if (pmc_ctx.uckr & CKGR_UCKR_UPLLEN)
+		pmc_wait(PMC_SR_LOCKU, "UTMI PLL lock");
+	writel(pmc_ctx.usb, pmc + PMC_USB);
+
+	/* A programmable clock is configured while it is stopped, then started */
+	for (i = 0; i < 2; i++)
+		writel(pmc_ctx.pck[i], pmc + PMC_PCK(i));
+	writel(sc, pmc + PMC_SCER);
+	writel(~sc & PMC_SYSCLK_MASK, pmc + PMC_SCDR);
+	for (i = 0; i < 2; i++)
+		if (sc & BIT(8 + i))
+			pmc_wait(PMC_SR_PCKRDY(i), "programmable clock");
+
+	/* The PIO banks need their clock to be written, see pio_restore() */
+	writel(pc | PMC_PCLK_PIO, pmc + PMC_PCER);
+	writel(~pc & PMC_PCLK_MASK & ~PMC_PCLK_PIO, pmc + PMC_PCDR);
+}
+
+static void aic_restore(void)
+{
+	int i;
+
+	/*
+	 * Same start as aic_hw_init(): end of interrupt x8 so that the AIC is
+	 * not locked out, everything disabled and cleared. Then the vectors and
+	 * the source modes, and only then the mask, so that nothing fires with
+	 * reset-state priorities.
+	 */
+	for (i = 0; i < 8; i++)
+		writel(0, aic + AIC_EOICR);
+	writel(~0, aic + AIC_IDCR);
+	writel(~0, aic + AIC_ICCR);
+	writel(aic_ctx.spu, aic + AIC_SPU);
+	writel(aic_ctx.dcr, aic + AIC_DCR);
+	for (i = 0; i < AIC_NR_IRQ; i++)
+		writel(aic_ctx.svr[i], aic + AIC_SVR(i));
+	for (i = 0; i < AIC_NR_IRQ; i++)
+		writel(aic_ctx.smr[i], aic + AIC_SMR(i));
+	if (aic_ctx.ffsr)
+		writel(aic_ctx.ffsr, aic + AIC_FFER);
+	writel(aic_ctx.imr, aic + AIC_IECR);
+}
+
+static void pio_restore(void)
+{
+	int i, b;
+
+	for (b = 0; b < NR_PIO; b++) {
+		void __iomem *base = pio[b];
+
+		for (i = 0; i < ARRAY_SIZE(pio_items); i++) {
+			const struct pio_item *it = &pio_items[i];
+			u32 v = pio_ctx[b][i];
+
+			if (i == PIO_ISR_BEFORE)
+				readl(base + PIO_ISR);	/* clears latched status */
+			writel(v, base + it->set);
+			if (it->clr)
+				writel(~v, base + it->clr);
+		}
+	}
+
+	/* Put back the clock gating the PIO banks had before the sleep */
+	writel(~pmc_ctx.pcsr & PMC_PCLK_PIO, pmc + PMC_PCDR);
+}
+
+static void hw_restore(void)
+{
+	pmc_restore();
+	aic_restore();
+	pio_restore();
+}
+
+static int at91_sam9_backup_finish(unsigned long val)
+{
+	flush_cache_all();
+	sram_fn(lpr, shdwc);
+	return -EIO;	/* not reached */
+}
+
+bool at91_sam9_backup_ready(void)
+{
+	return sram_fn != NULL;
+}
+
+int at91_sam9_backup_suspend(void)
+{
+	u32 saved_gpbr1;
+	int ret;
+
+	/* GPBR1 is also the boot progress marker: keep it across the sleep */
+	saved_gpbr1 = readl(gpbr + GPBR1);
+
+	writel(MARK_SUSPENDING, gpbr + GPBR3);
+	writel(0, gpbr + GPBR2);
+	writel(__pa_symbol(at91_sam9_backup_resume), gpbr + GPBR1);
+	writel(BSC_CR_SPI_BOOT, bsc_cr);
+	/* A stale RTC flag would turn the sleep into an immediate wake */
+	writel(RTC_SCCR_ALL, rtc_sccr);
+	writel(BOOT_MAGIC, gpbr + GPBR0);
+
+	hw_save();
+	flush_cache_all();
+	ret = cpu_suspend(0, at91_sam9_backup_finish);
+
+	/* A hang in the restore shows as GPBR3 = MARK_BACK_IN_C */
+	writel(MARK_BACK_IN_C, gpbr + GPBR3);
+	if (!ret) {
+		/* Power was cut: nothing else may run before this is done */
+		hw_restore();
+		writel(MARK_HW_RESTORED, gpbr + GPBR3);
+	}
+
+	writel(0, gpbr + GPBR0);
+	writel(0, gpbr + GPBR2);
+	writel(saved_gpbr1, gpbr + GPBR1);
+
+	/* The SRAM content is lost with the core power */
+	sram_fn = fncpy(sram_fn, &at91_sam9_backup_sram, sram_sz);
+
+	if (ret)
+		pr_info("at91-backup: suspend aborted (%d)\n", ret);
+	else
+		pr_info("at91-backup: resumed, SHDW_SR=0x%08x\n",
+			readl(shdwc + SHDW_SR));
+	return ret;
+}
+
+void __init at91_sam9_backup_init(void)
+{
+	struct device_node *node;
+	struct platform_device *pdev = NULL;
+	struct gen_pool *pool;
+	dma_addr_t phys;
+	bool fail = false;
+	void *sram;
+	int i;
+
+	sram_sz = at91_sam9_backup_sram_end - (char *)at91_sam9_backup_sram;
+
+	for_each_compatible_node(node, NULL, "mmio-sram") {
+		pdev = of_find_device_by_node(node);
+		if (pdev) {
+			of_node_put(node);
+			break;
+		}
+	}
+	if (!pdev) {
+		pr_warn("at91-backup: no SRAM device\n");
+		return;
+	}
+
+	pool = gen_pool_get(&pdev->dev, NULL);
+	if (!pool)
+		goto out;
+
+	/* fncpy() wants the destination aligned to 8 bytes */
+	sram = gen_pool_dma_alloc_align(pool, sram_sz, &phys, 8);
+	if (!sram)
+		goto out;
+
+	lpr = ioremap(DDRSDRC_LPR_PHYS, 4);
+	shdwc = ioremap(SHDW_CR_PHYS, 0x10);
+	bsc_cr = ioremap(BSC_CR_PHYS, 4);
+	gpbr = ioremap(GPBR_PHYS, 0x10);
+	rtc_sccr = ioremap(RTC_SCCR_PHYS, 4);
+	pmc = ioremap(PMC_PHYS, 0x100);
+	aic = ioremap(AIC_PHYS, 0x200);
+	for (i = 0; i < NR_PIO; i++) {
+		pio[i] = ioremap(PIO_PHYS(i), 0x200);
+		if (!pio[i])
+			fail = true;
+	}
+	if (fail || !pmc || !aic || !lpr || !shdwc || !bsc_cr || !gpbr ||
+	    !rtc_sccr) {
+		pr_warn("at91-backup: register mapping failed\n");
+		goto out;
+	}
+
+	sram_fn = __arm_ioremap_exec(phys, sram_sz, false);
+	if (!sram_fn) {
+		pr_warn("at91-backup: SRAM mapping failed\n");
+		goto out;
+	}
+	sram_fn = fncpy(sram_fn, &at91_sam9_backup_sram, sram_sz);
+	pr_info("at91-backup: sleep enabled\n");
+out:
+	put_device(&pdev->dev);
+}
diff --git a/arch/arm/mach-at91/pm_sam9_backup_asm.S b/arch/arm/mach-at91/pm_sam9_backup_asm.S
new file mode 100644
index 0000000..899dc4f
--- /dev/null
+++ b/arch/arm/mach-at91/pm_sam9_backup_asm.S
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Backup sleep for the SAM9x5 family, in the style of the stock firmware:
+ * the SDRAM is put in self-refresh and the shutdown controller cuts VDDCORE.
+ * On wake the at91bootstrap in SPI flash jumps to at91_sam9_backup_resume
+ * (address in GPBR1) with the MMU and caches off.
+ */
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+#include <asm/ptrace.h>
+
+#define GPBR_BASE		0xfffffe60
+#define GPBR2_OFF		0x08
+#define GPBR3_OFF		0x0c
+#define BACKUP_RESUMED		0x4D505701
+
+	.arm
+	.text
+
+/*
+ * Resume entry, physical addresses, MMU off. at91bootstrap only jumps here if
+ * the word right before GPBR1 holds 0x2bedf00d, so no padding is allowed
+ * between that word and the label. Mark GPBR3, clear the bootstrap's boot
+ * counter in GPBR2 (more than 3 means SAM-BA) and continue in cpu_resume.
+ */
+	.align	2
+	.word	0x2bedf00d
+	.globl	at91_sam9_backup_resume
+	.type	at91_sam9_backup_resume, %function
+at91_sam9_backup_resume:
+	ldr	r0, 1f
+	ldr	r1, 2f
+	str	r1, [r0, #GPBR3_OFF]
+	mov	r1, #0
+	str	r1, [r0, #GPBR2_OFF]
+	b	cpu_resume
+1:	.word	GPBR_BASE
+2:	.word	BACKUP_RESUMED
+	.size	at91_sam9_backup_resume, . - at91_sam9_backup_resume
+
+/*
+ * Runs from SRAM with the MMU on, interrupts must stay off.
+ *   r0 = DDRSDRC LPR (virtual), r1 = SHDW_CR (virtual)
+ * Same sequence and constants as the stock kernel. The registers are read
+ * first so that their TLB entries are loaded, and the constants are loaded
+ * into registers: a page table walk after self-refresh entry would read the
+ * SDRAM and take it out of self-refresh. Never returns; if the power is not
+ * cut, the watchdog resets the SoC.
+ */
+	.align	3
+ENTRY(at91_sam9_backup_sram)
+	mrs	ip, cpsr
+	orr	ip, ip, #(PSR_I_BIT | PSR_F_BIT)
+	msr	cpsr_c, ip		@ no IRQ/FIQ (ARMv5 has no cpsid)
+	ldr	r2, [r0]
+	ldr	r2, [r1]
+	ldr	r2, 3f
+	ldr	r3, 4f
+	mov	ip, #0
+	mcr	p15, 0, ip, c7, c10, 4	@ drain write buffer
+	ldr	ip, 5f
+	str	r2, [r0]		@ DDRSDRC LPR: self-refresh
+1:	subs	r3, r3, #1		@ about 1.5 ms at 382 MHz
+	bne	1b
+	str	ip, [r1]		@ SHDW_CR: key | SHDW
+2:	mcr	p15, 0, r2, c7, c0, 4	@ wait for interrupt
+	b	2b
+3:	.word	0x00300301		@ LPR: self-refresh, stock value
+4:	.word	200000
+5:	.word	0xa5000001
+ENTRY(at91_sam9_backup_sram_end)
+ENDPROC(at91_sam9_backup_sram)
