#!/bin/sh
# stub i2cset -y BUS ADDR REG VAL: registers are files in $STUB_STATE/regs; "ro-REG" files make a register ignore writes
echo "i2cset $*" >> "$STUB_STATE/calls"
mkdir -p "$STUB_STATE/regs"
r=$(printf '%d' "$4")
[ -f "$STUB_STATE/regs/ro-$r" ] && exit 0
printf '0x%02x\n' "$(printf '%d' "$5")" > "$STUB_STATE/regs/$r"
