.venv/
__pycache__/
# Device dumps, downloads and decompiles: kept locally, not tracked.
# Backups contain device identifiers.
backup/
analysis/
downloads/
decomp-uploader-win/
*.bin
*.ext2
*.tgz

buildroot/
dl/
output/
output-restore/
restore/*.elf
tools/tapscope/tapscope
tools/tapscope/clicktest
/.ccache/
/output-fast/
/output-restore-fast/

# Private notes (analysis of the stock firmware, board notes, photos): not published. A doc becomes public only
# once reviewed, by adding a !/docs/NAME.md line below.
/docs/*
!/docs/PHONE_USB.md
!/docs/DESIGN_OVERVIEW.md
!/docs/GPS_PROCESSING.md
!/docs/img/
/docs/img/*
!/docs/img/gps/
!/docs/img/test_pads.png
!/docs/img/logo.svg
!/docs/img/logo.png

