#!/bin/sh
# stub devmem: reads of PIOC_PDSR come from $STUB_STATE/vbus.seq (one word per line, "present"/"absent";
# the last line repeats), GPBR1/2/3 and RTT_MR/RTT_VR from files (RTT defaults: prescaler 32, count 0x100000); writes are recorded in $STUB_STATE/calls and stored.
S=$STUB_STATE
if [ $# -ge 3 ]; then
	echo "devmem write $1 $3" >> "$S/calls"
	case "$1" in 0xfffffe68) echo "$3" > "$S/gpbr2" ;; 0xfffffe64) echo "$3" > "$S/gpbr1" ;; 0xfffffe6c) echo "$3" > "$S/gpbr3" ;; esac
	exit 0
fi
case "$1" in
0xfffff83c)
	w=$(head -n 1 "$S/vbus.seq")
	[ "$(wc -l < "$S/vbus.seq")" -gt 1 ] && sed -i 1d "$S/vbus.seq"
	if [ "$w" = present ]; then echo 0x00000000; else echo 0x80000000; fi
	;;
0xfffffe68) cat "$S/gpbr2" 2>/dev/null || echo 0x00000001 ;;
0xfffffe64) cat "$S/gpbr1" 2>/dev/null || echo 0x4D500010 ;;
0xfffffe6c) cat "$S/gpbr3" 2>/dev/null || echo 0x00000000 ;;
0xfffffe20) cat "$S/rtt_mr" 2>/dev/null || echo 0x00000020 ;;
0xfffffe28) cat "$S/rtt_vr" 2>/dev/null || echo 0x00100000 ;;
0xfffffe2c) echo 0x00000000 ;;
*) exit 1 ;;
esac
